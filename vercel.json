    { "source": "/why-structzero", "destination": "/platform/", "permanent": true },
    { "source": "/architecture-overview/:path*", "destination": "/docs/architecture/", "permanent": true },
    { "source": "/architecture-overview", "destination": "/docs/architecture/", "permanent": true },
    { "source": "/plugin-system/:path*", "destination": "/integrations/", "permanent": true },
