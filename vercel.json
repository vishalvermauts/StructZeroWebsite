{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(robots\\.txt|sitemap\\.xml|sitemap-index\\.xml|favicon\\.svg)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    }
  ],
  "redirects": [
    { "source": "/platform-overview/:path*", "destination": "/platform/", "permanent": true },
    { "source": "/platform-overview", "destination": "/platform/", "permanent": true },
    { "source": "/debate-engine/:path*", "destination": "/docs/architecture/", "permanent": true },
    { "source": "/debate-engine", "destination": "/docs/architecture/", "permanent": true },
    { "source": "/project-dna/:path*", "destination": "/docs/architecture/", "permanent": true },
    { "source": "/project-dna", "destination": "/docs/architecture/", "permanent": true },
    { "source": "/certification/:path*", "destination": "/docs/workflows/", "permanent": true },
    { "source": "/certification", "destination": "/docs/workflows/", "permanent": true },
    { "source": "/ai-team/:path*", "destination": "/modules/", "permanent": true },
    { "source": "/ai-team", "destination": "/modules/", "permanent": true },
    { "source": "/plugins-hub/:path*", "destination": "/integrations/", "permanent": true },
    { "source": "/plugins-hub", "destination": "/integrations/", "permanent": true },
    { "source": "/plugins/:path*", "destination": "/integrations/", "permanent": true },
    { "source": "/plugins", "destination": "/integrations/", "permanent": true },
    { "source": "/mcp-server/:path*", "destination": "/docs/integrations/", "permanent": true },
    { "source": "/mcp-server", "destination": "/docs/integrations/", "permanent": true },
    { "source": "/docs/mcp-setup/:path*", "destination": "/docs/integrations/", "permanent": true },
    { "source": "/docs/mcp-setup", "destination": "/docs/integrations/", "permanent": true },
