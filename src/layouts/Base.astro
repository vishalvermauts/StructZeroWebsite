---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  schemaType?: string;
  ogImage?: string;
  videoUrl?: string;
}

const {
  title,
  description,
  schemaType = 'WebPage',
  ogImage = 'https://www.structzero.app/Multi-Agent_Engineering_Pipeline.png',
  videoUrl,
} = Astro.props;

// Ensure consistent canonical URL with trailing slash policy
let pathWithSlash = Astro.url.pathname;
if (!pathWithSlash.endsWith('/')) {
  pathWithSlash += '/';
}
const canonicalURL = new URL(pathWithSlash, 'https://www.structzero.app');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- OpenGraph Metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="StructZero Platform" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="StructZero AI Software Engineering Platform" />

    {videoUrl && (
      <>
        <meta property="og:video" content={videoUrl} />
        <meta property="og:video:type" content="video/mp4" />
      </>
    )}

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://www.structzero.app/#organization",
          "name": "StructZero",
          "url": "https://www.structzero.app",
          "logo": "https://www.structzero.app/favicon.svg",
          "sameAs": [
            "https://github.com/vishalvermauts/StructZeroWebsite"
          ],
          "description": "AI software engineering platform coordinating modular workflows to research, build, verify, secure, deploy, and operate software."
        },
        {
          "@type": "WebSite",
          "@id": "https://www.structzero.app/#website",
          "url": "https://www.structzero.app",
          "name": "StructZero Platform",
          "publisher": {
            "@id": "https://www.structzero.app/#organization"
          }
        },
        {
          "@type": schemaType,
          "@id": `${canonicalURL.toString()}#webpage`,
          "url": canonicalURL.toString(),
          "name": title,
          "description": description,
          "isPartOf": {
            "@id": "https://www.structzero.app/#website"
          }
        }
      ]
    })} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="StructZero Updates RSS Feed" href="/rss.xml" />

    <!-- Performance-optimized on-demand Mermaid initializer -->
    <script type="module">
      const renderMermaid = async () => {
        const blocks = document.querySelectorAll('pre.mermaid, code.language-mermaid, pre[data-language="mermaid"]');
        if (blocks.length === 0) return;

        // Lazy-load Mermaid ESM only on pages with actual diagram blocks
        const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs');
        mermaid.initialize({
          startOnLoad: false,
          theme: 'base',
          themeVariables: {
            darkMode: true,
            background: '#000000',
            primaryColor: '#111111',
            primaryTextColor: '#e9e9ea',
            primaryBorderColor: '#4d8fe0',
            lineColor: '#4d8fe0',
            secondaryColor: '#1a1a1a',
            secondaryTextColor: '#e9e9ea',
            secondaryBorderColor: '#2c2c2c',
            tertiaryColor: '#0a0a0a',
            tertiaryTextColor: '#e9e9ea',
            tertiaryBorderColor: '#1e1e1e',
            nodeBkg: '#111111',
            nodeTextColor: '#e9e9ea',
            nodeBorder: '#4d8fe0',
            clusterBkg: '#0a0a0a',
            clusterBorder: '#1e1e1e',
            titleColor: '#e9e9ea',
            edgeLabelBackground: '#0a0a0a'
          }
        });

        for (let i = 0; i < blocks.length; i++) {
          const block = blocks[i];
          const code = block.textContent.trim();
          const container = document.createElement('div');
          container.className = 'mermaid my-6 p-4 rounded-xl border border-[#1e1e1e] bg-[#111111] text-center overflow-x-auto min-h-[100px] flex items-center justify-center';
          block.replaceWith(container);
          try {
            const { svg } = await mermaid.render(`mermaid-diagram-${i}`, code);
            container.innerHTML = svg;
          } catch (e) {
            console.error('Mermaid rendering notice:', e);
            const pre = document.createElement('pre');
            pre.className = 'text-xs text-left font-mono text-[#96979a] overflow-x-auto p-3';
            pre.textContent = code;
            container.innerHTML = '';
            container.appendChild(pre);
          }
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderMermaid);
      } else {
        renderMermaid();
      }
    </script>
  </head>
  <body class="bg-[#000000] text-[#e9e9ea] antialiased">
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
