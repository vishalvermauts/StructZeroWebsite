---
export interface Props {
  status: 'Available' | 'Preview' | 'In Development' | 'Planned' | 'Exploring' | 'LIVE' | 'Production' | string;
  size?: 'sm' | 'md' | 'lg';
}

const { status, size = 'md' } = Astro.props;

const normalized = status.toUpperCase();

let colorClasses = 'bg-[#111111] text-[#96979a] border-[#1e1e1e]';
let dotClass = 'bg-[#7c7d80]';

if (normalized.includes('AVAILABLE') || normalized.includes('LIVE') || normalized.includes('PRODUCTION')) {
  colorClasses = 'bg-[#0f2417] text-[#4f9e6e] border-[#1e3a29]';
  dotClass = 'bg-[#4f9e6e]';
} else if (normalized.includes('PREVIEW') || normalized.includes('DEVELOPMENT')) {
  colorClasses = 'bg-[#2b2210] text-[#c19a4a] border-[#423318]';
  dotClass = 'bg-[#c19a4a]';
} else if (normalized.includes('PLANNED')) {
  colorClasses = 'bg-[#101c2c] text-[#7cadec] border-[#1e3450]';
  dotClass = 'bg-[#4d8fe0]';
} else if (normalized.includes('EXPLORING')) {
  colorClasses = 'bg-[#22172e] text-[#b388eb] border-[#38264e]';
  dotClass = 'bg-[#b388eb]';
}

const sizeClasses = {
  sm: 'px-2 py-0.5 text-[11px]',
  md: 'px-2.5 py-1 text-xs',
  lg: 'px-3 py-1.5 text-sm',
}[size];
---

<span class={`inline-flex items-center font-mono font-medium rounded-full border ${colorClasses} ${sizeClasses}`}>
  <span class={`w-1.5 h-1.5 rounded-full mr-1.5 shrink-0 ${dotClass}`}></span>
  {status}
</span>
