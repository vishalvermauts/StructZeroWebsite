---
export interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className = '' } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
>
  <line x1="16" y1="7" x2="7" y2="22" stroke="currentColor" stroke-width="1.6" opacity="0.55" />
  <line x1="16" y1="7" x2="25" y2="22" stroke="currentColor" stroke-width="1.6" opacity="0.55" />
  <line x1="7" y1="22" x2="25" y2="22" stroke="currentColor" stroke-width="1.6" opacity="0.55" />
  <circle cx="16" cy="7" r="4" fill="currentColor" />
  <circle cx="7" cy="22" r="3.2" fill="currentColor" />
  <circle cx="25" cy="22" r="3.2" fill="currentColor" />
</svg>
