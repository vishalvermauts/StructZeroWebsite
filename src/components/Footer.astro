---
import BrandMark from './BrandMark.astro';

const footerSections = [
  {
    title: 'Product',
    links: [
      { label: 'Platform & Autonomy', href: '/platform/' },
      { label: 'Modules Directory', href: '/modules/' },
      { label: 'Native Android Control', href: '/android/' },
      { label: 'Integrations & Providers', href: '/integrations/' },
      { label: 'Interactive Demo', href: '/demo/' },
      { label: 'Security & Guardrails', href: '/security/' },
    ],
  },
  {
    title: 'Resources & Docs',
    links: [
      { label: 'Documentation Hub', href: '/docs/' },
      { label: 'Getting Started', href: '/docs/getting-started/' },
      { label: 'Workflows & Verification', href: '/docs/workflows/' },
      { label: 'Integrations Setup', href: '/docs/integrations/' },
      { label: 'Architecture & Concepts', href: '/docs/architecture/' },
      { label: 'Product Roadmap', href: '/roadmap/' },
      { label: 'Platform Updates', href: '/updates/' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About StructZero', href: '/about/' },
      { label: 'Contact & Walkthrough', href: '/contact/' },
      { label: 'Security Controls', href: '/security/' },
      { label: 'Responsible AI Policy', href: '/legal/responsible-ai/' },
    ],
  },
  {
    title: 'Legal & Governance',
    links: [
      { label: 'Privacy Policy', href: '/legal/privacy/' },
      { label: 'Terms of Service', href: '/legal/terms/' },
      { label: 'Security Policy', href: '/legal/security-policy/' },
      { label: 'Acceptable Use', href: '/legal/acceptable-use/' },
      { label: 'Data Processing (DPA)', href: '/legal/data-processing/' },
      { label: 'Cookie Policy', href: '/legal/cookies/' },
      { label: 'Accessibility', href: '/legal/accessibility/' },
      { label: 'Open Source Notices', href: '/legal/licenses/' },
    ],
  },
];
---

<footer class="border-t border-[#1e1e1e] bg-[#000000] pt-16 pb-12 text-[#96979a]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 lg:gap-12 mb-14">
      {footerSections.map(section => (
        <div>
          <h3 class="font-mono text-xs uppercase tracking-wider text-[#7cadec] font-semibold mb-4">
            {section.title}
          </h3>
          <ul class="space-y-2.5 text-sm">
            {section.links.map(link => (
              <li>
                <a href={link.href} class="hover:text-[#e9e9ea] transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-[#1e1e1e] pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#7c7d80]">
      <div class="flex items-center gap-2.5">
        <div class="w-5 h-5 rounded bg-[#111111] border border-[#2c2c2c] flex items-center justify-center text-[#4d8fe0]">
          <BrandMark size={14} />
        </div>
        <span class="font-semibold text-[#e9e9ea]">StructZero Platform</span>
        <span class="hidden md:inline text-[#2c2c2c]">|</span>
        <span class="hidden md:inline">Command center for governed AI-built software.</span>
      </div>
      <div class="flex items-center gap-4">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono bg-[#111111] text-[#4f9e6e] border border-[#1e1e1e]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#4f9e6e]"></span>
          Version 11 Preview
        </span>
        <span>© {new Date().getFullYear()} StructZero. All rights reserved.</span>
      </div>
    </div>
  </div>
</footer>
