---
import Base from '../layouts/Base.astro';
import StatusBadge from '../components/StatusBadge.astro';

const milestones = [
  {
    version: 'Version 11 Core',
    date: 'Current Release',
    status: 'Available',
    description: 'Foundation of Multi-Model Engineering Engine, AST Project DNA Parser, and Pre-Flight Certification Gates.',
    features: [
      { name: 'Multi-Model Debate (Claude, Gemini, DeepSeek)', status: 'Available' },
      { name: 'AST Project DNA Ingestion & Route Topologies', status: 'Available' },
      { name: 'Automated Pre-Flight Certification Gate', status: 'Available' },
      { name: 'Docker Container Sandboxed Execution', status: 'Available' },
      { name: 'AWS & Vercel Edge Deployment Adapters', status: 'Available' },
      { name: 'Budget Ceilings & Token Metering', status: 'Available' },
    ],
  },
  {
    version: 'Version 11 Remote',
    date: 'In Development',
    status: 'In Development',
    description: 'Extending software engineering governance to mobile with StructZero Remote for Android.',
    features: [
      { name: 'StructZero Remote Native Android Client', status: 'In Development' },
      { name: 'Biometric & Push-Notification Operator Approvals', status: 'In Development' },
      { name: 'Live WebSocket Telemetry & Latency Streaming', status: 'In Development' },
      { name: 'Offline Action Queueing & Replay Protection', status: 'In Development' },
      { name: 'Android Native Gradle Build Pipeline', status: 'In Development' },
    ],
  },
  {
    version: 'Version 12 Platform',
    date: 'Planned',
    status: 'Planned',
    description: 'Autonomous continuous improvement, cross-cloud deployment orchestration, and enterprise RBAC.',
    features: [
      { name: 'Autonomous Continuous Patch Verification', status: 'Planned' },
      { name: 'Multi-Cloud Workload Synthesis (AWS, GCP, Azure)', status: 'Planned' },
      { name: 'Enterprise SAML/SSO & Role-Based Access Control', status: 'Planned' },
      { name: 'Automated Dead-Code Pruning & AST Optimization', status: 'Planned' },
    ],
  },
  {
    version: 'Research Horizon',
    date: 'Exploring',
    status: 'Exploring',
    description: 'Long-term research into autonomous portfolio refactoring and system self-healing.',
    features: [
      { name: 'Autonomous Technical Debt Reduction Loops', status: 'Exploring' },
      { name: 'Business Impact & Feature ROI Estimation', status: 'Exploring' },
    ],
  },
];
---

<Base
  title="Product Roadmap & Availability — StructZero"
  description="Transparent development timeline for StructZero platform capabilities, release statuses, and milestones."
>
  <section class="py-16 border-b border-[#1e1e1e] bg-[#0a0a0a]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <div class="inline-flex items-center gap-2 mb-3">
        <StatusBadge status="Available" size="sm" />
        <span class="font-mono text-xs uppercase tracking-wider text-[#7cadec] font-semibold">
          Transparent Milestones
        </span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-[#e9e9ea] mb-4">
        Platform Roadmap & Availability
      </h1>
      <p class="text-base sm:text-lg text-[#96979a] max-w-2xl mx-auto">
        Every capability clearly tagged with its true development and release state. No unverified claims.
      </p>
    </div>
  </section>

  <section class="py-16 bg-[#000000]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-12">
      {milestones.map(m => (
        <div class="border border-[#1e1e1e] rounded-2xl p-6 sm:p-8 bg-[#111111] space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-[#1e1e1e] pb-4">
            <div>
              <span class="font-mono text-xs text-[#7c7d80] block mb-1">{m.date}</span>
              <h2 class="text-2xl font-bold text-[#e9e9ea]">{m.version}</h2>
            </div>
            <StatusBadge status={m.status} size="md" />
          </div>

          <p class="text-sm text-[#96979a] leading-relaxed">{m.description}</p>

          <div class="space-y-3">
            <h3 class="font-mono text-xs uppercase text-[#7cadec] font-semibold">Milestone Deliverables</h3>
            <div class="grid sm:grid-cols-2 gap-3">
              {m.features.map(f => (
                <div class="flex items-center justify-between p-3 rounded-xl bg-[#000000] border border-[#1e1e1e] text-xs">
                  <span class="text-[#e9e9ea] font-medium">{f.name}</span>
                  <StatusBadge status={f.status} size="sm" />
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
