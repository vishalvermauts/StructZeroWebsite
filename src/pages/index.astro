---
import Base from '../layouts/Base.astro';
import StatusBadge from '../components/StatusBadge.astro';
import BrandMark from '../components/BrandMark.astro';
import '../styles/global.css';

const lifecycleSteps = [
  { step: '01', name: 'Research', desc: 'Ingest codebase AST, dependency graphs, API specs, and technical documentation.' },
  { step: '02', name: 'Plan', desc: 'Formulate architecture blueprints, topological order, and cross-model design critique.' },
  { step: '03', name: 'Build', desc: 'Generate dependency-ordered source code strictly aligned to type contracts.' },
  { step: '04', name: 'Verify', desc: 'Pre-flight AST compilation, module import resolution, and automated repair loops.' },
  { step: '05', name: 'Review', desc: 'Human authorization pause for billable cloud provisioning, schema shifts, and releases.' },
  { step: '06', name: 'Deploy', desc: 'Ship certified static bundles or container workloads to Vercel, AWS, or GCP.' },
  { step: '07', name: 'Monitor', desc: 'Live event streaming, model token consumption, latency, and budget meter telemetry.' },
  { step: '08', name: 'Improve', desc: 'Governed continuous patching, feedback loops, and persistent project memory.' },
];

const faqs = [
  {
    q: 'How does StructZero differ from single-model code assistants?',
    a: 'Single-model tools prompt-and-pray in a single pass without independent review, leading to hallucinated imports, broken routes, and undetected bugs. StructZero operates as a coordinated AI software engineering platform: parsing syntax trees (Project DNA), debating architecture across independent models, validating code in sandboxes before disk write, and enforcing strict human approval gates.',
  },
  {
    q: 'Can we use our own models or local Ollama endpoints?',
    a: 'Yes. StructZero is provider-neutral. You can configure Claude, Gemini, DeepSeek, Amazon Bedrock, or your own local Ollama endpoints for specific roles (e.g. Claude for Architecture, DeepSeek for Code, Gemini for Security Audit).',
  },
  {
    q: 'How does StructZero prevent accidental cloud charges or data loss?',
    a: 'Every billable action (e.g. AWS provisioning, serverless deployments) or destructive command (e.g. DROP TABLE, resource deletion) triggers a hard human-in-the-loop authorization pause. Projects also enforce pre-configured budget ceilings per run.',
  },
];
---

<Base
  title="StructZero — AI Software Engineering Platform"
  description="Coordinates modular workflows to research, build, verify, secure, deploy, and operate software — with budgets, approvals, and an immutable record of every change."
  schemaType="SoftwareApplication"
>
  <!-- Section 1: Hero -->
  <section class="relative pt-16 pb-20 overflow-hidden border-b border-[#1e1e1e] bg-[#000000]">
    <div class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[500px] rounded-full opacity-20" style="background: radial-gradient(ellipse at center, #4d8fe0, transparent 70%);"></div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 relative text-center">

      <!-- Availability Chip -->
      <div class="inline-flex items-center gap-2 mb-6">
        <StatusBadge status="Available" size="md" />
        <span class="text-xs font-mono text-[#7c7d80]">Version 11 Technical Preview</span>
      </div>

      <h1 class="text-4xl sm:text-6xl md:text-7xl font-bold tracking-tight text-[#e9e9ea] leading-[1.08] mb-6">
        Your AI Software <br class="hidden sm:inline" />
        <span class="text-[#4d8fe0]">Engineering Platform</span>.
      </h1>

      <p class="text-lg sm:text-xl text-[#96979a] max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
        Coordinates modular workflows to research, build, verify, secure, deploy, and operate software — with budgets, approvals, and an immutable record of every change.
      </p>

      <!-- Primary Action CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
        <a
          href="/demo/"
          class="w-full sm:w-auto px-6 py-3.5 rounded-lg bg-[#4d8fe0] text-[#000000] font-semibold text-sm hover:bg-[#7cadec] transition-all shadow-lg shadow-[#4d8fe0]/10 flex items-center justify-center gap-2"
        >
          <span>Explore Interactive Demo</span>
          <span>→</span>
        </a>
        <a
          href="/contact/"
          class="w-full sm:w-auto px-6 py-3.5 rounded-lg bg-[#111111] border border-[#2c2c2c] text-[#e9e9ea] font-medium text-sm hover:bg-[#1a1a1a] transition-colors flex items-center justify-center gap-2"
        >
          <span>Request Access & Walkthrough</span>
        </a>
      </div>

      <!-- Section 2: Product Proof (Platform Workspace Canvas Matching App UI) -->
      <div class="rounded-2xl border border-[#1e1e1e] bg-[#0a0a0a] overflow-hidden shadow-2xl text-left">
        <!-- Canvas Top Bar -->
        <div class="flex items-center justify-between px-4 py-3 border-b border-[#1e1e1e] bg-[#000000]">
          <div class="flex items-center gap-3">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
            </div>
            <div class="flex items-center gap-2 text-xs font-mono text-[#96979a] pl-2 border-l border-[#1e1e1e]">
              <span class="text-[#e9e9ea] font-semibold flex items-center gap-1.5">
                <span class="text-[#4d8fe0]">▲</span> StructZero
              </span>
              <span class="text-[#7c7d80]">/</span>
              <span>Workspace: aurora-studio</span>
            </div>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded text-[11px] font-mono bg-[#101c2c] text-[#7cadec] border border-[#2c2c2c]">
              <span class="w-1.5 h-1.5 rounded-full bg-[#4f9e6e]"></span>
              aurora-studio · BUILD
            </span>
            <span class="text-[11px] font-mono text-[#96979a] px-2 py-0.5 bg-[#111111] rounded border border-[#1e1e1e]">
              Open Full IDE
            </span>
          </div>
        </div>

        <!-- Canvas Body: Authentic 3-Pane Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-12 divide-y lg:divide-y-0 lg:divide-x divide-[#1e1e1e] bg-[#000000]">
          <!-- Left Column: Session Drawer & Active Sessions -->
          <div class="lg:col-span-3 p-4 space-y-4 bg-[#0a0a0a]">
            <!-- Action Button -->
            <button type="button" class="w-full py-2 px-3 rounded-lg bg-[#101c2c] border border-[#2c2c2c] text-[#7cadec] font-medium text-xs flex items-center justify-center gap-1.5 hover:bg-[#1a2c42] transition-colors">
              <span>+ New Engineering Session</span>
            </button>

            <div class="space-y-2">
              <div class="text-[11px] font-mono uppercase tracking-wider text-[#7c7d80]">Recent Sessions</div>
              <div class="space-y-1 text-xs">
                <div class="p-2 rounded-md bg-[#111111] border border-[#2c2c2c] flex items-center justify-between text-[#e9e9ea]">
                  <span class="font-medium text-[#7cadec]">aurora-studio</span>
                  <span class="text-[10px] font-mono text-[#4f9e6e]">ACTIVE</span>
                </div>
                <div class="p-2 rounded-md hover:bg-[#111111] flex items-center justify-between text-[#96979a] transition-colors">
                  <span>dummy-preview-p...</span>
                  <span class="text-[10px] font-mono text-[#7c7d80]">IDLE</span>
                </div>
                <div class="p-2 rounded-md hover:bg-[#111111] flex items-center justify-between text-[#96979a] transition-colors">
                  <span>neonfalcon</span>
                  <span class="text-[10px] font-mono text-[#7c7d80]">IDLE</span>
                </div>
                <div class="p-2 rounded-md hover:bg-[#111111] flex items-center justify-between text-[#96979a] transition-colors">
                  <span>project-lunarecho</span>
                  <span class="text-[10px] font-mono text-[#7c7d80]">IDLE</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Center Column: Workflow Steps & Metric Widgets -->
          <div class="lg:col-span-4 p-4 space-y-4 bg-[#000000]">
            <!-- Lifecycle Breadcrumb Strip -->
            <div class="flex items-center gap-1 text-[11px] font-mono text-[#7c7d80] overflow-x-auto pb-1 border-b border-[#1e1e1e]">
              <span class="text-[#4f9e6e]">● Define</span>
              <span>→</span>
              <span class="text-[#4f9e6e]">● Research</span>
              <span>→</span>
              <span class="text-[#4f9e6e]">● Debate</span>
              <span>→</span>
              <span class="text-[#7cadec] font-bold">● Build</span>
            </div>

            <!-- Widgets Grid -->
            <div class="space-y-3">
              <div class="p-3 rounded-xl border border-[#1e1e1e] bg-[#111111]">
                <div class="text-[10px] font-mono text-[#7c7d80] uppercase">API Usage</div>
                <div class="text-sm font-semibold text-[#e9e9ea] mt-0.5">Sandboxed Container</div>
                <div class="text-[11px] text-[#96979a]">Claude 3.5 Sonnet + Gemini Flash</div>
              </div>

              <div class="p-3 rounded-xl border border-[#1e1e1e] bg-[#111111]">
                <div class="text-[10px] font-mono text-[#7c7d80] uppercase">Billing & Guardrails</div>
                <div class="text-sm font-semibold text-[#e9e9ea] mt-0.5">$14.20 / $50.00 Limit</div>
                <div class="w-full bg-[#000000] h-1.5 rounded-full mt-2 overflow-hidden border border-[#1e1e1e]">
                  <div class="bg-[#4f9e6e] h-full" style="width: 28%"></div>
                </div>
              </div>

              <div class="p-3 rounded-xl border border-[#1e1e1e] bg-[#111111]">
                <div class="flex items-center justify-between">
                  <div class="text-[10px] font-mono text-[#7c7d80] uppercase">Preview Target</div>
                  <span class="text-[10px] font-mono text-[#4f9e6e] flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#4f9e6e] animate-pulse"></span> Live
                  </span>
                </div>
                <div class="text-xs text-[#96979a] mt-1">Generated: 18 files · 0 syntax defects</div>
              </div>
            </div>
          </div>

          <!-- Right Column: Live Artifact Canvas / Workspace Preview -->
          <div class="lg:col-span-5 p-4 space-y-3 bg-[#0a0a0a]">
            <div class="flex items-center justify-between text-xs border-b border-[#1e1e1e] pb-2">
              <span class="font-mono text-[#7cadec] font-semibold">PREVIEW: aurora / 01</span>
              <span class="text-[11px] font-mono text-[#7c7d80]">index.html</span>
            </div>

            <!-- Terminal / Event Stream Output -->
            <div class="p-3 rounded-xl bg-[#000000] border border-[#1e1e1e] font-mono text-xs space-y-1.5">
              <div class="text-[#7c7d80]">[14:32:01] <span class="text-[#4f9e6e]">ProjectDNA:</span> Abstract Syntax Tree parsed: 142 exports.</div>
              <div class="text-[#7c7d80]">[14:32:04] <span class="text-[#7cadec]">Debate:</span> Architect (Claude) proposal critiqued by Reviewer (Gemini).</div>
              <div class="text-[#7c7d80]">[14:32:08] <span class="text-[#b388eb]">Judge:</span> DeepSeek R1 approved final layout patch.</div>
              <div class="text-[#7c7d80]">[14:32:12] <span class="text-[#4f9e6e]">Certify:</span> Syntax: PASS | Imports: PASS | Build: PASS</div>
              <div class="text-[#c19a4a]">[14:32:15] Intercept: PAUSED awaiting operator deploy approval.</div>
            </div>

            <div class="p-3 rounded-lg bg-[#111111] border border-[#2c2c2c] flex items-center justify-between text-xs">
              <span class="text-[#e9e9ea]">Operator Confirmation:</span>
              <div class="flex gap-2">
                <span class="px-2.5 py-1 rounded text-[11px] font-semibold bg-[#4f9e6e] text-[#000000]">Approve</span>
                <span class="px-2.5 py-1 rounded text-[11px] font-semibold bg-[#1a1a1a] text-[#e9e9ea] border border-[#2c2c2c]">Deny</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: 8-Stage Lifecycle -->
  <section class="py-20 border-b border-[#1e1e1e] bg-[#0a0a0a]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="font-mono text-xs uppercase tracking-wider text-[#7cadec] font-semibold block mb-2">
          Governed Execution Pipeline
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#e9e9ea] mb-4">
          The 8-Stage Engineering Lifecycle
        </h2>
        <p class="text-base text-[#96979a]">
          Every generation follows the exact sequence an enterprise engineering department would execute.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {lifecycleSteps.map((item) => (
          <div class="p-5 rounded-xl border border-[#1e1e1e] bg-[#111111] hover:border-[#2c2c2c] transition-colors">
            <div class="flex items-center justify-between mb-3">
              <span class="font-mono text-xs font-bold text-[#7cadec]">{item.step}</span>
              <span class="w-2 h-2 rounded-full bg-[#4d8fe0]/30"></span>
            </div>
            <h3 class="text-base font-bold text-[#e9e9ea] mb-1.5">{item.name}</h3>
            <p class="text-xs sm:text-sm text-[#96979a] leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 4: Three Core Outcome Groups -->
  <section class="py-20 border-b border-[#1e1e1e] bg-[#000000]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="font-mono text-xs uppercase tracking-wider text-[#7cadec] font-semibold block mb-2">
          Purpose-Built Architecture
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#e9e9ea] mb-4">
          Engineered for Real Software Production
        </h2>
        <p class="text-base text-[#96979a]">
          Three distinct operational workflows configured for developers, teams, and autonomous pipelines.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Outcome 1 -->
        <div class="p-6 rounded-2xl border border-[#1e1e1e] bg-[#111111] flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-[#101c2c] border border-[#2c2c2c] flex items-center justify-center text-[#7cadec] mb-5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-[#e9e9ea] mb-2.5">Build a Product</h3>
            <p class="text-sm text-[#96979a] leading-relaxed mb-4">
              Turn specifications into multi-file production applications. Files are written in strict topological dependency order with validated interfaces and zero dangling imports.
            </p>
          </div>
          <div class="pt-4 border-t border-[#1e1e1e] text-xs font-mono text-[#7c7d80]">
            AST Project DNA · Pre-flight compilation
          </div>
        </div>

        <!-- Outcome 2 -->
        <div class="p-6 rounded-2xl border border-[#1e1e1e] bg-[#111111] flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-[#0f2417] border border-[#1e3a29] flex items-center justify-center text-[#4f9e6e] mb-5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-[#e9e9ea] mb-2.5">Operate a Portfolio</h3>
            <p class="text-sm text-[#96979a] leading-relaxed mb-4">
              Manage dozens of concurrent projects from a centralized dashboard. Inspect historical runs, model token spend, latency metrics, and container sandboxes in real time.
            </p>
          </div>
          <div class="pt-4 border-t border-[#1e1e1e] text-xs font-mono text-[#7c7d80]">
            Multi-project telemetry · Cost attribution
          </div>
        </div>

        <!-- Outcome 3 -->
        <div class="p-6 rounded-2xl border border-[#1e1e1e] bg-[#111111] flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-[#2b2210] border border-[#423318] flex items-center justify-center text-[#c19a4a] mb-5">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-[#e9e9ea] mb-2.5">Improve Safely</h3>
            <p class="text-sm text-[#96979a] leading-relaxed mb-4">
              Enforce strict human authorization boundaries for cloud deployments, migrations, and destructive operations. Autonomous runs stop and wait for explicit sign-off.
            </p>
          </div>
          <div class="pt-4 border-t border-[#1e1e1e] text-xs font-mono text-[#7c7d80]">
            Budget ceilings · Isolated preview environments
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 5: Web + Native Android Control -->
  <section class="py-20 border-b border-[#1e1e1e] bg-[#0a0a0a]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-6 space-y-6">
          <span class="font-mono text-xs uppercase tracking-wider text-[#7cadec] font-semibold block">
            Dual Control Surfaces
          </span>
          <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#e9e9ea] leading-tight">
            Web Interface & <br />Native Android Remote Control
          </h2>
          <p class="text-base text-[#96979a] leading-relaxed">
            Manage projects from your workstation or authorize critical deployment gates from anywhere. StructZero Remote connects natively via secure WebSocket protocols to give you mobile command over runs, budgets, and releases.
          </p>
          <ul class="space-y-3 text-sm text-[#96979a]">
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded bg-[#101c2c] text-[#7cadec] flex items-center justify-center shrink-0 mt-0.5 font-bold">✓</span>
              <span><strong>Real-time push notifications</strong> when runs require operator approval.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded bg-[#101c2c] text-[#7cadec] flex items-center justify-center shrink-0 mt-0.5 font-bold">✓</span>
              <span><strong>Live run telemetry</strong>: model token burn, build step logs, and health status.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="w-5 h-5 rounded bg-[#101c2c] text-[#7cadec] flex items-center justify-center shrink-0 mt-0.5 font-bold">✓</span>
              <span><strong>Separate generated-app pipeline</strong>: build native Android apps with Gradle sandboxes.</span>
            </li>
          </ul>
          <div>
            <a href="/android/" class="inline-flex items-center gap-2 text-sm font-semibold text-[#4d8fe0] hover:text-[#7cadec] transition-colors">
              Explore Native Android Architecture →
            </a>
          </div>
        </div>

        <div class="lg:col-span-6">
          <div class="p-6 rounded-2xl border border-[#1e1e1e] bg-[#111111] shadow-xl">
            <div class="flex items-center justify-between pb-4 border-b border-[#1e1e1e] mb-4 text-xs font-mono text-[#7c7d80]">
              <span>REMOTE EVENT PUSH</span>
              <span class="text-[#4f9e6e]">LIVE SYNC</span>
            </div>
            <div class="space-y-3">
              <div class="p-3.5 rounded-lg bg-[#000000] border border-[#423318] flex items-center justify-between">
                <div>
                  <div class="text-xs font-semibold text-[#e9e9ea]">Run #104 Paused</div>
                  <div class="text-[11px] text-[#7c7d80]">Action: Deploy to Vercel Edge</div>
                </div>
                <div class="flex gap-2">
                  <span class="px-2.5 py-1 rounded text-[11px] font-semibold bg-[#4f9e6e] text-[#000000]">Approve</span>
                  <span class="px-2.5 py-1 rounded text-[11px] font-semibold bg-[#1a1a1a] text-[#e9e9ea] border border-[#2c2c2c]">Deny</span>
                </div>
              </div>
              <div class="p-3.5 rounded-lg bg-[#000000] border border-[#1e1e1e] text-xs space-y-1">
                <div class="text-[#7c7d80]">Active Device: Pixel 8 Pro (Android 14)</div>
                <div class="text-[#7c7d80]">Authentication: mTLS + JWT Session Token</div>
                <div class="text-[#4f9e6e]">Heartbeat: 140ms latency</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 6: Trust, Evidence & Controls -->
  <section class="py-20 border-b border-[#1e1e1e] bg-[#000000]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="font-mono text-xs uppercase tracking-wider text-[#7cadec] font-semibold block mb-2">
          Enterprise Security Posture
        </span>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-[#e9e9ea] mb-4">
          Strict Isolation & Audit Guarantees
        </h2>
        <p class="text-base text-[#96979a]">
          Engineered for regulated environments where uncontrolled agent execution is unacceptable.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="p-5 rounded-xl border border-[#1e1e1e] bg-[#111111]">
          <h3 class="text-base font-semibold text-[#e9e9ea] mb-2">Container Sandboxing</h3>
          <p class="text-xs sm:text-sm text-[#96979a] leading-relaxed">
            All code compilation, tests, and generation run inside isolated container sandboxes with strictly confined filesystem boundaries.
          </p>
        </div>
        <div class="p-5 rounded-xl border border-[#1e1e1e] bg-[#111111]">
          <h3 class="text-base font-semibold text-[#e9e9ea] mb-2">Immutable Audit Trails</h3>
          <p class="text-xs sm:text-sm text-[#96979a] leading-relaxed">
