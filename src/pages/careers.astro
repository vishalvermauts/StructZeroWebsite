---
import Base from '../layouts/Base.astro';
---

<Base title="Careers — Join StructZero Engineering" description="Build the future of autonomous AI software engineering platforms.">
  <section class="py-20 max-w-4xl mx-auto px-6 text-center">
    <span class="font-mono text-xs uppercase text-accent font-semibold block mb-3">Join The Team</span>
    <h1 class="text-4xl font-bold mb-4">Engineering Careers at StructZero</h1>
    <p class="text-ink-muted leading-relaxed max-w-2xl mx-auto mb-8">
      We are building the future of multi-agent software engineering systems. We hire world-class compiler, AST, distributed systems, and AI security engineers.
    </p>
    <div class="p-8 border border-border rounded-2xl bg-panel text-left">
      <h2 class="text-xl font-bold text-ink mb-2">Systems & Compiler Engineer</h2>
      <p class="text-sm text-ink-muted mb-4">Remote · Full-time · AST Parsing & Multi-Agent Orchestration</p>
      <a href="mailto:careers@structzero.app" class="inline-block bg-accent text-white font-semibold text-xs px-4 py-2 rounded-md">Apply via Email →</a>
    </div>
  </section>
</Base>
