---
import SubpageLayout from '../../layouts/SubpageLayout.astro';
---

<SubpageLayout
  title="Acceptable Use Policy"
  description="Guidelines for acceptable platform usage and guardrails."
  status="Official Spec"
  summary="StructZero must not be utilized for malicious software generation, security exploit generation, or unauthorized infrastructure disruption."
  related={[
    { label: 'Security Policy', href: '/legal/security-policy/' },
    { label: 'Terms of Service', href: '/legal/terms/' },
  ]}
>
  <div class="space-y-6">
    <div>
      <h2 class="text-xl font-bold text-[#e9e9ea] mb-3">Prohibited Activities</h2>
      <ul class="space-y-2 text-sm text-[#96979a] list-disc list-inside">
        <li>Generating malware, ransomware, spyware, or zero-day exploit payloads.</li>
        <li>Attempting unauthorized access, penetration testing, or disruption of third-party cloud infrastructure.</li>
        <li>Bypassing human authorization intercepts for billable or destructive operations.</li>
        <li>Deploying autonomous agents without appropriate operator oversight in production environments.</li>
      </ul>
    </div>
  </div>
</SubpageLayout>
