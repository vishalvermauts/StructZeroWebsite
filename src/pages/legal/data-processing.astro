---
import SubpageLayout from '../../layouts/SubpageLayout.astro';
---

<SubpageLayout
  title="Data Processing Addendum (DPA)"
  description="Enterprise data processing terms and compliance standards."
  status="Official Spec"
  summary="The StructZero Data Processing Addendum governs customer data processing, sub-processor disclosures, and compliance with global privacy regulations."
  related={[
    { label: 'Privacy Policy', href: '/legal/privacy/' },
    { label: 'Security Policy', href: '/legal/security-policy/' },
  ]}
>
  <div class="space-y-6">
    <div>
      <h2 class="text-xl font-bold text-[#F5F7FB] mb-2">Sub-Processors & Model Infrastructure</h2>
      <p class="text-sm text-[#B7C2D6] leading-relaxed">
        StructZero routes model queries to authorized provider endpoints (Anthropic, Google Cloud Vertex AI, AWS Bedrock) under strict zero-retention enterprise agreements. Customer intellectual property is never retained for model retraining.
      </p>
    </div>

    <div>
      <h2 class="text-xl font-bold text-[#F5F7FB] mb-2">Data Residency & Workspace Isolation</h2>
      <p class="text-sm text-[#B7C2D6] leading-relaxed">
        All generated codebases and AST symbol caches remain confined to your specified local workspace or designated customer cloud container instances.
      </p>
    </div>
  </div>
</SubpageLayout>
