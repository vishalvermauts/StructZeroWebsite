---
import SubpageLayout from '../../layouts/SubpageLayout.astro';
---

<SubpageLayout
  title="Open Source Notices & Licensing"
  description="Open source attribution and third-party software licensing disclosures."
  status="Official Spec"
  summary="StructZero incorporates open source libraries including Astro, Tailwind CSS, GSAP, and Mermaid.js under their respective licenses."
  related={[
    { label: 'Terms of Service', href: '/legal/terms/' },
  ]}
>
  <div class="space-y-6">
    <div>
      <h2 class="text-xl font-bold text-[#F5F7FB] mb-3">Open Source Attributions</h2>
      <ul class="space-y-2 text-sm text-[#B7C2D6] list-disc list-inside">
        <li><strong>Astro</strong>: MIT License (Copyright © with Astro contributors)</li>
        <li><strong>Tailwind CSS</strong>: MIT License (Copyright © Tailwind Labs, Inc.)</li>
        <li><strong>Mermaid.js</strong>: MIT License (Copyright © Knut Sveidqvist)</li>
        <li><strong>GSAP</strong>: Standard GreenSock Web License</li>
      </ul>
    </div>
  </div>
</SubpageLayout>
