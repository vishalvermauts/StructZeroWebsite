---
import SubpageLayout from '../../layouts/SubpageLayout.astro';
---

<SubpageLayout
  title="Accessibility Statement"
  description="Our commitment to WCAG 2.1 AA accessibility standards."
  status="Official Spec"
  summary="StructZero is designed to meet WCAG 2.1 AA accessibility guidelines, offering high-contrast typography, screen-reader navigation, and full keyboard support."
  related={[
    { label: 'About StructZero', href: '/about/' },
    { label: 'Terms of Service', href: '/legal/terms/' },
  ]}
>
  <div class="space-y-6">
    <div>
      <h2 class="text-xl font-bold text-[#F5F7FB] mb-3">Accessibility Standards & Features</h2>
      <ul class="space-y-2 text-sm text-[#B7C2D6] list-disc list-inside">
        <li>High-contrast dark palette with tested foreground and background contrast ratios.</li>
        <li>Full keyboard navigation across all interactive navigation menus, buttons, and form inputs.</li>
        <li>Semantic HTML5 landmark tags (<code class="text-[#4F8BFF] bg-[#0B1020] px-1 py-0.5 rounded">header</code>, <code class="text-[#4F8BFF] bg-[#0B1020] px-1 py-0.5 rounded">nav</code>, <code class="text-[#4F8BFF] bg-[#0B1020] px-1 py-0.5 rounded">main</code>, <code class="text-[#4F8BFF] bg-[#0B1020] px-1 py-0.5 rounded">footer</code>) and ARIA attributes.</li>
        <li>Native <code class="text-[#4F8BFF] bg-[#0B1020] px-1 py-0.5 rounded">prefers-reduced-motion</code> CSS styles respecting user motion sensitivities.</li>
      </ul>
    </div>
  </div>
</SubpageLayout>
