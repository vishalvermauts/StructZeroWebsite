---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const blogPosts = await getCollection('blog');
---

<Base
  title="StructZero Engineering Blog — Technical Articles"
  description="In-depth technical articles on multi-model debate, AST project DNA parsing, and autonomous engineering systems."
>
  <section class="py-20 border-b border-border bg-panel/30">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <span class="font-mono text-xs uppercase tracking-wider text-accent block mb-3">Engineering Insights</span>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-4">Engineering Blog</h1>
      <p class="text-lg text-ink-muted max-w-2xl mx-auto">
        Deep dives from the core team on building enterprise-grade multi-agent software engineering systems.
      </p>
    </div>
  </section>

  <section class="py-16 max-w-4xl mx-auto px-6 space-y-8">
    {blogPosts.map(post => (
      <article class="p-8 border border-border rounded-2xl bg-panel">
        <div class="flex items-center gap-3 text-xs text-ink-faint font-mono mb-3">
          <span>{post.data.pubDate.toISOString().split('T')[0]}</span>
          <span>·</span>
          <span>{post.data.author}</span>
        </div>
        <h2 class="text-2xl font-bold text-ink mb-3 hover:text-accent transition-colors">
          <a href={`/blog/${post.slug}`}>{post.data.title}</a>
        </h2>
        <p class="text-ink-muted leading-relaxed mb-6">{post.data.description}</p>
        <div class="flex items-center justify-between">
          <div class="flex gap-2">
            {post.data.tags.map(tag => (
              <span class="font-mono text-[10px] uppercase px-2.5 py-1 rounded bg-bg border border-border text-ink-muted">{tag}</span>
            ))}
          </div>
          <a href={`/blog/${post.slug}`} class="text-xs font-semibold text-accent hover:underline">Read Article →</a>
        </div>
      </article>
    ))}
  </section>
</Base>
